RPC_URL=https://rpc.testnet.whitechain.io
# Wallet keys: leave empty to use PRIVATE_KEY from ../.env (the repo deployer).
# Run with: node --env-file=../.env --env-file=.env <script>
# Deploy
DEPLOYER_PRIVATE_KEY=
PRICE_UNITS=250000
# Relayer (holds WBT, pays gas)
RELAYER_PRIVATE_KEY=
RELAYER_API_KEY=
LOOKUP_PAY_ADDRESS=
PORT=8787
MAX_TX_PER_DAY=500
MAX_WINDOW_SECONDS=3600
LOW_WBT=0.05
# scripts/pay.mjs (holds USDT, no WBT)
PAYER_PRIVATE_KEY=
RELAYER_URL=http://localhost:8787
